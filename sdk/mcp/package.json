{
  "name": "@dashtro/mcp",
  "version": "0.1.1",
  "description": "MCP server for Dashtro CMS — run via npx, points at your Dashtro instance's URL, no other install required",
  "license": "MIT",
  "author": "Atharva Devasthali",
  "repository": {
    "type": "git",
    "url": "https://github.com/1atharvad/dashtro.git",
    "directory": "sdk/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dashtro-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format cjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
