# Combined DashTro image: builds the frontend, then serves it (as static
# files) and the API from a single FastAPI/uvicorn process. Build from the
# repo root: `docker build -f Dockerfile.dashtro -t dashtro .`

FROM node:20-alpine AS frontend-build

WORKDIR /frontend
COPY cms-frontend/package.json cms-frontend/package-lock.json ./
# --legacy-peer-deps: @vitejs/plugin-react@4.3.4's peerDependencies range
# predates vite 7 (this repo's version) even though it works fine with it;
# `npm ci` enforces strict peer resolution where `npm install` doesn't.
RUN npm ci --legacy-peer-deps
COPY cms-frontend/ .
ARG APP_VERSION=dev
ENV VITE_APP_VERSION=$APP_VERSION
RUN npm run build

# Renders the password-reset email (a React Email component) to the static
# HTML/text the backend actually sends — see emails/render.ts. Rebuilt fresh
# on every image build so the shipped email can never go stale relative to
# whatever's committed in emails/templates/, regardless of whether someone
# remembered to run `npm run build` there locally.
FROM node:20-alpine AS emails-build

WORKDIR /emails
COPY emails/package.json emails/package-lock.json ./
RUN npm ci
COPY emails/ .
RUN npm run build

FROM python:3.12-slim

WORKDIR /app

# Node renders RichText wrapper components to static HTML server-side (see
# cms_backend/react_render/) — the Python process itself has no JS runtime.
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

COPY cms_backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Full copy (not just package.json) since the build needs render.ts too;
# devDependencies are pruned after so the runtime image doesn't carry them.
COPY cms_backend/react_render/ react_render/
RUN cd react_render && npm install && npm run build && npm prune --omit=dev

COPY cms_backend/ .
COPY --from=frontend-build /frontend/dist ./static
COPY --from=emails-build /cms_backend/api/utils/email_templates ./api/utils/email_templates

EXPOSE 7312

# No curl in python:3.12-slim; use urllib instead.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:7312/health', timeout=2)" || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7312"]
