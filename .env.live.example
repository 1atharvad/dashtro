# Copy to .env.live (gitignored) to run the opt-in live test suites against
# a real deployed instance without exporting env vars each time:
#   cms_backend/tests/test_live_instance.py
#   cms_mcp/tests/test_live_mcp.py
# Kept separate from .env (normal local dev config) so staging credentials
# don't mix with it. A real env var of the same name always takes priority
# over this file if both are set.

# Base URL of the deployed instance to test against, e.g. Render staging.
LIVE_CMS_BASE_URL=https://dashtro-staging.onrender.com

# Must be an UNSCOPED API key (no project_id bound to it) — these suites
# create and delete their own scratch projects, which only an unscoped key
# is allowed to do. Issue one from that instance's CMS settings page.
LIVE_CMS_API_KEY=
